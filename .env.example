PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://ilm_user:ilm_pass@localhost:5432/ilm_api
PG_POOL_MAX=20

# Redis (optional but recommended for caching)
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# User accounts (bookmarking/study lists) — separate from developer api_keys
JWT_SECRET=replace-with-a-long-random-string
